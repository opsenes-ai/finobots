# Public values only. Every secret (AI keys, PayPal credentials, the
# encryption key) is a Supabase function secret, never a NEXT_PUBLIC_ variable.
# See README > Supabase set-up.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"

# Optional. Used for robots.txt and sitemap.xml. Defaults to https://finobots.vercel.app
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
